# Resend API key (https://resend.com/api-keys). Without it the Brief form logs
# the payload to the server console in development and reports an error in
# production.
RESEND_API_KEY=

# Where briefs are delivered and the sender shown on the email. The FROM domain
# must be verified in Resend (SPF + DKIM for prismal.ae) before it will send.
BRIEF_TO_EMAIL=hello@prismal.ae
BRIEF_FROM_EMAIL="PRISMAL <hello@prismal.ae>"

# Cookieless analytics — set one of the two. Nothing loads while both are
# empty, and neither sets cookies, so there is no consent banner to show.
# Plausible: the site domain as registered there; the script URL only for a
# self-hosted instance.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Umami (self-hosted): the tracker script URL and the website id it gave you.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
